; Engine configuration file.
; Projeto Godot 4.7 — ENTREGA IMPOSSÍVEL (versão PC/Steam).

config_version=5

[application]

config/name="Entrega Impossível"
config/description="Entregas contra o relógio numa cidade viva: trânsito, chuva, atalhos arriscados."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.086, 0.094, 0.141, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Loc="*res://autoload/loc.gd"
Bus="*res://autoload/bus.gd"
Settings="*res://autoload/settings.gd"
GameState="*res://autoload/game_state.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
common/physics_interpolation=true
3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.086, 0.094, 0.141, 1)

[shader_globals]

wetness={
"type": "float",
"value": 0.0
}
night={
"type": "float",
"value": 0.0
}
