extends Node
## Textos do jogo em português (padrão) e inglês.
## Uso: Loc.t("menu.play") ou Loc.t("hud.reward", [350]) com "{0}" no texto.

const LANGUAGES := ["pt", "en"]

var language := "pt"

var _tables := {
	"pt": {},
	"en": {},
}


func _ready() -> void:
	_load_tables()
	var system := OS.get_locale_language()
	language = "pt" if system == "pt" else "en"


func set_language(code: String) -> void:
	if code == "" or not LANGUAGES.has(code):
		var system := OS.get_locale_language()
		code = "pt" if system == "pt" else "en"
	if code != language:
		language = code
		Bus.language_changed.emit()


func t(key: String, args: Array = []) -> String:
	var table: Dictionary = _tables.get(language, {})
	var text: String = table.get(key, _tables["pt"].get(key, key))
	if args.is_empty():
		return text
	return text.format(args)


func has(key: String) -> bool:
	return _tables["pt"].has(key)


func _add(key: String, pt: String, en: String) -> void:
	_tables["pt"][key] = pt
	_tables["en"][key] = en


